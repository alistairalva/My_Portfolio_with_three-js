# Replace the values with your own and rename the file  to .env

# Values for EmailJS settings 
VITE_APP_EMAILJS_SERVICE_ID=xxxxxxxxxxxx
VITE_APP_EMAILJS_TEMPLATE_ID=xxxxxxxxxxxx 
VITE_APP_EMAILJS_PUBLIC_API_KEY=xxxxxxxxxxxx # Public ID found in user settings
VITE_APP_EMAIL=xxxxxxxxxxxxxxxxxxxxxxx # This is your own email

# SEO audit form endpoint (Google Apps Script / backend API)
AUDIT_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
