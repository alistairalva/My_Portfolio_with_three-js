{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ssr": "tsx server.ts",
    "build": "tsc && vite build",
    "build:ssr": "tsc && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preview:ssr": "tsx server.ts",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:model": "gltf-transform optimize tools/model-source/desktop_pc/scene.gltf public/desktop_pc/scene.optimized.glb --compress draco --texture-compress webp --texture-size 1024 --meshopt-level high"
  },
  "overrides": {
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.1",
    "@emailjs/browser": "^4.3.3",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.15",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.15.15",
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint . --ext ts,tsx,astro --report-unused-disable-directives --max-warnings 0",
    "preview": "astro preview",
    "framer-motion": "^11.1.7",
    "maath": "^0.10.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-horizontal-scrolling-menu": "^7.1.0",
    "react-parallax-tilt": "^1.7.227",
    "@astrojs/vercel": "^8.2.1",
    "react-router-dom": "^6.23.0",
    "react-scroll": "^1.9.0",
    "react-tilt": "^1.0.2",
    "react-toastify": "^10.0.5",
    "react-vertical-timeline-component": "^3.6.0",
    "styled-components": "^6.1.8",
    "three": "^0.164.1",
    "typewriter-effect": "^2.21.0"
  },
  "devDependencies": {
    "astro": "^5.18.1",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.19",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-vertical-timeline-component": "^3.3.6",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "astro": "^6.3.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.19.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
